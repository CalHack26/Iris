# Copy to .env.local (git-ignored) and fill in. Without these the app runs on its local seed data.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# anon / publishable key ONLY — never the service-role key
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DEMO_EMAIL=demo@calhacks.dev
EXPO_PUBLIC_DEMO_PASSWORD=
